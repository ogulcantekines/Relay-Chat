{
  "name": "mern-chatapp",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon backend/server.js",
    "start": "node backend/server.js",
    "serve": "nodemon backend/server.js",
    "client": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "install:all": "npm install && cd frontend && npm install",
    "test": "node scripts/smoke-test.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "test:realtime": "node scripts/realtime-test.js",
    "test:all": "npm test && npm run test:realtime && npm run test:ui",
    "test:ui": "node scripts/ui-test.js"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Real-time chat application built with the MERN stack and Socket.IO",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.19.0",
    "mongoose": "^8.18.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "playwright": "^1.63.0",
    "socket.io-client": "^4.8.3"
  }
}
