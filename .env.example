# Sunucunun çalışacağı port
PORT=5000

# MongoDB bağlantı adresi
# Atlas: mongodb+srv://<kullanici>:<sifre>@<cluster>.mongodb.net/chatapp
# Yerel: mongodb://127.0.0.1:27017/chatapp
MONGO_URI=

# JWT imzalama anahtarı. Uzun ve rastgele bir değer üretin, örn:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

NODE_ENV=development

# Oturum çerezine Secure bayrağı eklensin mi?
# HTTPS arkasında "true" yapın. Düz HTTP ile (yerel ağ, localhost) "true"
# olursa tarayıcı çerezi saklamaz ve giriş yapılamaz.
COOKIE_SECURE=false

# Socket.IO CORS izni verilecek istemci adresi
CLIENT_URL=http://localhost:3000
