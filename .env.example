# Used by local Node development and Docker Compose; never commit .env.
NODE_ENV=development
PORT=5000

# Node development only. Compose uses its private mongo service instead.
MONGO_URI=mongodb://127.0.0.1:27017/relay

# At least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Host port for Docker Compose; use 5010 if port 5000 is already occupied.
APP_PORT=5000

# Uygulamanın hangi ağ arayüzünde dinleyeceği.
# 127.0.0.1 yalnızca bu makine; 0.0.0.0 aynı ağdaki diğer cihazlar da erişir.
# 0.0.0.0 kullanırken CLIENT_URL'i makinenin LAN adresine ayarlayın.
BIND_ADDRESS=127.0.0.1
# Optional immutable tag for deployment/rollback; defaults to relay-chat:local.
# APP_IMAGE=relay-chat:your-commit

# Same-origin requests are allowed. Use http://localhost:3000 for the Vite dev UI.
# With a changed APP_PORT, also change this origin to match the browser URL.
CLIENT_URL=http://localhost:5000

# false for local HTTP; true only when a proxy serves public HTTPS.
COOKIE_SECURE=false
# 0 for direct/local Docker access; 1 for exactly one trusted host reverse proxy.
TRUST_PROXY=0